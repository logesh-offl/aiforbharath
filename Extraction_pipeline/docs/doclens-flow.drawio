<mxfile host="app.diagrams.net">
  <diagram id="doclens-flow" name="DocLens Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1"
                  page="1" pageScale="1" pageWidth="1000" pageHeight="1400"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User uploads -->
        <mxCell id="upload" value="User uploads image or PDF&lt;br&gt;in the React frontend"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Mode decision -->
        <mxCell id="modeDecision" value="Single file or&lt;br&gt;batch mode?"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Single endpoint -->
        <mxCell id="singleEndpoint" value="POST /api/process"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="180" y="250" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Batch endpoint -->
        <mxCell id="batchEndpoint" value="POST /api/batch&lt;br&gt;one file at a time"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="620" y="250" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- FastAPI backend -->
        <mxCell id="backend" value="FastAPI backend"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="390" y="340" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- File type decision -->
        <mxCell id="fileTypeDecision" value="File type?"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="415" y="440" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- PDF rasterize -->
        <mxCell id="pdfRasterize" value="PyMuPDF rasterizes&lt;br&gt;each page to an image"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="650" y="450" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- EasyOCR -->
        <mxCell id="easyocr" value="EasyOCR reads text&lt;br&gt;from the image"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="415" y="560" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- Raw text -->
        <mxCell id="rawText" value="Raw extracted text"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="415" y="650" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Instruction decision -->
        <mxCell id="instructionDecision" value="Custom instruction&lt;br&gt;provided?"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="405" y="730" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Default summary prompt -->
        <mxCell id="defaultPrompt" value="Default summarization prompt"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="150" y="850" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Custom prompt -->
        <mxCell id="customPrompt" value="Custom instruction prompt&lt;br&gt;(extract dates, translate,&lt;br&gt;list action items, etc.)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="620" y="840" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- edge0 -->
        <mxCell id="edge0" value="edge0 model generates a response&lt;br&gt;SSD expert offload + prerouter + LoRA"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="360" y="960" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Result returned -->
        <mxCell id="resultReturned" value="Result returned to the frontend"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="390" y="1060" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Final display -->
        <mxCell id="finalDisplay" value="Single result card, or per-file&lt;br&gt;batch results + JSON download"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="1150" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- Note: local only -->
        <mxCell id="localNote" value="Everything below this line runs locally &#8212; no network calls except the frontend&#8217;s own localhost API"
                style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="330" y="405" width="340" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="upload" target="modeDecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Single file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="modeDecision" target="singleEndpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="modeDecision" target="batchEndpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="singleEndpoint" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="batchEndpoint" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="backend" target="fileTypeDecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="fileTypeDecision" target="easyocr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="fileTypeDecision" target="pdfRasterize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="pdfRasterize" target="easyocr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="easyocr" target="rawText">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="rawText" target="instructionDecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="instructionDecision" target="defaultPrompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="instructionDecision" target="customPrompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="defaultPrompt" target="edge0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="customPrompt" target="edge0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="edge0" target="resultReturned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="resultReturned" target="finalDisplay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
